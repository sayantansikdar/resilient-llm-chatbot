# ---- backend ----
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-gemini-key,your-second-gemini-key
# LiteLLM model name used by every key
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional: one model per key instead, same order as LLM_API_KEYS
# LLM_MODELS=gemini/gemini-3.5-flash-lite,gemini/gemini-3.1-flash-lite
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
# Optional tuning
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant. Keep answers clear and concise.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
LLM_TIMEOUT_SECONDS=30
HISTORY_MAX_MESSAGES=40

# ---- frontend ----
# Backend URL the browser talks to (Docker: written to /env.js at start)
FRONTEND_API_URL=http://localhost:8000
# Same thing for `npm run build` / Vercel
VITE_API_URL=http://localhost:8000
